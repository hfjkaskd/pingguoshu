{
  "module": "Connect_SDK",
  "version": "1.2.0",
  "sourceRoot": "",
  "includes": [
    "CommonPublicFileManifest",
    "SDKCommonFileManifest"
  ],
  "items": [
    {
      "name": "_Bizza_BuildTemplate（SDK 完整模板）",
      "source": "_Bizza_BuildTemplate",
      "destination": "@SHARED/_Bizza_BuildTemplate",
      "isDirectory": true,
      "required": true,
      "category": "SDK Android 完整构建模板",
      "shared": true
    },
    {
      "name": "SDK_WKY",
      "source": "Assets/BizzaWZ/Final/Connect_SDK/SDK_WKY",
      "destination": "SDK_WKY",
      "isDirectory": true,
      "required": true,
      "category": "SDK 功能代码",
      "excludes": [
        "API/DeviceNativeBridge.cs",
        "API/DeviceNativeBridge.cs.meta",
        "API/AndroidUtils/JavaBridgeUtils.cs",
        "API/AndroidUtils/JavaBridgeUtils.cs.meta",
        "API/AndroidUtils/AndroidJavaMessageDispatcher.cs",
        "API/AndroidUtils/AndroidJavaMessageDispatcher.cs.meta",
        "API/Event/GameEvent.cs",
        "API/Event/GameEvent.cs.meta",
        "API/Utils/DeviceInfoUtil.cs",
        "API/Utils/DeviceInfoUtil.cs.meta",
        "API/Utils/EncryptionUtil.cs",
        "API/Utils/EncryptionUtil.cs.meta",
        "API/Utils/HttpUtil.cs",
        "API/Utils/HttpUtil.cs.meta"
      ]
    },
    {
      "name": "BizzaAnalytics",
      "source": "Assets/BizzaWZ/Final/FunctionTools/BizzaAnalytics",
      "destination": "BizzaAnalytics",
      "isDirectory": true,
      "required": true,
      "category": "SDK 功能代码"
    },
    {
      "name": "PlayCloud_API",
      "source": "Assets/BizzaWZ/Final/Connect_SDK/PlayCloud_API",
      "destination": "../PlayCloud_API",
      "isDirectory": true,
      "required": true,
      "category": "SDK 功能代码",
      "allowParentDestination": true
    },
    {
      "name": "Pages",
      "source": "Assets/BizzaWZ/Final/Connect_SDK/Pages",
      "destination": "../Pages",
      "isDirectory": true,
      "required": true,
      "category": "SDK 依赖资源",
      "allowParentDestination": true
    },
    {
      "name": "提示词调用模板.md",
      "source": "Assets/BizzaWZ/Final/Connect_SDK/提示词调用模板.md",
      "destination": "../提示词调用模板.md",
      "isDirectory": false,
      "required": true,
      "category": "迁移说明",
      "allowParentDestination": true
    },
    {
      "name": "Android",
      "source": "Assets/Plugins/Android",
      "destination": "Android",
      "isDirectory": true,
      "required": true,
      "category": "平台公共代码",
      "excludes": [
        "mainTemplate.gradle",
        "mainTemplate.gradle.meta"
      ]
    },
    {
      "name": "StreamingAssets",
      "source": "Assets/StreamingAssets",
      "destination": "StreamingAssets",
      "isDirectory": true,
      "required": true,
      "category": "项目配置"
    },
    {
      "name": "Connect_WKY_Prompt.md",
      "source": "Assets/BizzaWZ/Final/Connect_SDK/Connect_WKY_Prompt.md",
      "destination": "Connect_WKY_Prompt.md",
      "isDirectory": false,
      "required": false,
      "category": "迁移说明"
    }
  ]
}
